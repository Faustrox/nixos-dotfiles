      fuzzel = {
        enable = true;
        settings = {
          main = {
            dpi-aware = "yes";
            prompt = "‎";
            launch-prefix = "uwsm app --";
            width = 50;
            inner-pad = 15;
            fields = "filename,name";
          };
        };
      };
    };
    

    home = {

      packages = with pkgs; [

        # Multimedia
        clipse
        playerctl

        # System Apps
        nautilus
        gnome-system-monitor
        gparted
        waypaper
