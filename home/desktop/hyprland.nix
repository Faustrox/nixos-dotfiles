{ config, lib, pkgs, inputs, ... }:

{

  options = {
    hyprland.setup =
      lib.mkEnableOption "Enables and configure Hyprland";
  };

  config = lib.mkIf config.hyprland.setup {

    dunst.setup = false;
    waybar.setup = true;
    wofi.setup = false;

    programs.zsh.profileExtra = ''
      if uwsm check may-start; then
          exec uwsm start -S hyprland-uwsm.desktop
      fi
    '';

    stylix.targets.hyprland.enable = false;

    wayland.windowManager.hyprland = {
      
      enable = true;
      systemd = {
        enable = false;
        variables = ["--all"];
      };
      settings = {
        
        autogenerated = 0;
        env = [
          "XCURSOR_THEME,catppuccin-mocha-dark-cursors"
          "XCURSOR_SIZE,24"
          "HYPRCURSOR_THEME,catppuccin-mocha-dark-cursors"
          "HYPRCURSOR_SIZE,32"
        ];

        source = [
          "$HOME/.config/hypr/config/keybindings.conf"
          "$HOME/.config/hypr/config/rules.conf"
          "$HOME/.config/hypr/themes/mocha.conf"
        ];
        monitor = [
          "DP-1,2560x1440@165, 1920x0, 1"
          "DP-2,1920x1080@144, 0x360, 1"
        ];

        exec-once = [
          "systemctl start --user polkit-gnome-authentication-agent-1"
          "uwsm app -- swww-daemon"
          "uwsm app -- clipse --listen & wl-clip-persist --clipboard regular"
          "$HOME/.scripts/start.sh"

          "[workspace 1 silent] uwsm app -- firefox"
          "[workspace 5 silent] uwsm app -- telegram-desktop"
          "[workspace 5 silent] uwsm app -- firefoxpwa site launch 01JHYC1SG0EHMC6QK9EGM6FXFM"

          "sleep 5 && xrandr --output DP-1 --primary"
        ];

        #####################
        ### LOOK AND FEEL ###
        #####################

        # Refer to https://wiki.hyprland.org/Configuring/Variables/

        # https://wiki.hyprland.org/Configuring/Variables/#general
        general = { 

          gaps_in = 10;
          gaps_out = 20;

          border_size = 3;
          "col.active_border" = "$mauve $sapphire 45deg";
          "col.inactive_border" = "$overlay0";
          # Set to true enable resizing windows by clicking and dragging on borders and gaps
          resize_on_border = false;
          allow_tearing = true;
          layout = "dwindle";

        };

        decoration = {

          rounding = 15;
          # Change transparency of focused and unfocused windows
          active_opacity = 1.0;
          inactive_opacity = 1.0;

          shadow = {

            enabled = true;
            range = 15;
            render_power = 3;
            color = "$surface0";

          };

          blur = {

            enabled = true;
            size = 9;
            passes = 4;
            new_optimizations = true;
            vibrancy = 0.1696;

          };
        };

        animations = {

          enabled = true;

          bezier = [
            "myBezier, 0.05, 0.9, 0.1, 1.05"
            "myBezier2, 0.65, 0, 0.35, 1"
            "slow,0,0.85,0.3,1"
            "overshot,0.7,0.6,0.1,1.1"
            "bounce,1,1.6,0.1,0.85"
            "slingshot,1,-1,0.15,1.25"
            "nice,0,6.9,0.5,-4.20"
          ];
          animation = [
            "windows,1,5,bounce,popin"
            "border,1,20,default"
            "fade,1,5,default"
            "workspaces,1,5,overshot,slide"
          ];

        };

        dwindle = {

          pseudotile = true; # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
          preserve_split = true; # You probably want this

        };

        #############
        ### INPUT ###
        #############

        input = {

          kb_layout = "us";
          kb_variant = "intl";
          kb_model = "";
          kb_options = "";
          kb_rules = "";

          mouse_refocus = false;
          sensitivity = 0; # -1.0 - 1.0, 0 means no modification.
          accel_profile = "flat";
        
        };

        cursor = {

          enable_hyprcursor = true;
          inactive_timeout = 3;
          no_hardware_cursors = 0;
          use_cpu_buffer = true;

        };

        ##############
        ### OTHERS ###
        ##############

        misc = { 

          force_default_wallpaper = 0; # Set to 0 or 1 to disable the anime mascot wallpapers
          disable_hyprland_logo = true; # If true disables the random hyprland logo / anime girl background. :(
          animate_manual_resizes = true;

        };

        render = {

          explicit_sync = 0;
          explicit_sync_kms = 0;
          direct_scanout = true;
        
        };
        # opengl.nvidia_anti_flicker = false;

        # xwayland = {
        #   force_zero_scaling = false;
        # };

      };
    };

