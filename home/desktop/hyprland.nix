{ config, lib, pkgs, inputs, ... }:

{

  options = {
    hyprland.setup =
      lib.mkEnableOption "Enables and configure Hyprland";
  };

  config = lib.mkIf config.hyprland.setup {

    dunst.setup = false;
    waybar.setup = true;
    wofi.setup = false;

    programs.zsh.profileExtra = ''
      if uwsm check may-start; then
        exec uwsm start -S hyprland-uwsm.desktop
      fi
    '';

    stylix.targets.hyprland.enable = false;

    wayland.windowManager.hyprland = {
      
      enable = true;
      systemd.enable = false;
      settings = {
        
        autogenerated = 0;
        env = [
          "XCURSOR_THEME,catppuccin-mocha-dark-cursors"
          "XCURSOR_SIZE,24"
          "HYPRCURSOR_THEME,catppuccin-mocha-dark-cursors"
          "HYPRCURSOR_SIZE,32"
        ];

        source = [
          "$HOME/.config/hypr/config/keybindings.conf"
          "$HOME/.config/hypr/config/rules.conf"
          "$HOME/.config/hypr/themes/mocha.conf"
        ];
        monitor = [
          "DP-1, highres, 1920x0, 1, vrr, 2, bitdepth, 8"
          "DP-2, highres, 0x360, 1"
        ];

        exec-once = [
          "uwsm app -- swww-daemon"
          "uwsm app -- clipse --listen & wl-clip-persist --clipboard regular"
          "$HOME/.config/hypr/scripts/vrr-workaround.sh"
          "sleep 3 && $HOME/.scripts/start.sh"

          "[workspace 1 silent] uwsm app -- firefox"
          "[workspace 5 silent] uwsm app -- telegram-desktop"
          "[workspace 5 silent] uwsm app -- firefoxpwa site launch 01JHYC1SG0EHMC6QK9EGM6FXFM"

          "sleep 5 && xrandr --output DP-1 --primary"
        ];

        #####################
        ### LOOK AND FEEL ###
        #####################

        # Refer to https://wiki.hyprland.org/Configuring/Variables/

        # https://wiki.hyprland.org/Configuring/Variables/#general
        general = { 

          gaps_in = 10;
          gaps_out = 20;

          border_size = 3;
          "col.active_border" = "$mauve $sapphire 45deg";
          "col.inactive_border" = "$overlay0";
          # Set to true enable resizing windows by clicking and dragging on borders and gaps
          resize_on_border = false;
          allow_tearing = true;
          layout = "dwindle";

        };

        decoration = {

          rounding = 15;
          # Change transparency of focused and unfocused windows
          active_opacity = 1.0;
          inactive_opacity = 1.0;

          shadow = {

            enabled = true;
            range = 15;
            render_power = 3;
            color = "$surface0";

          };

          blur = {

            enabled = true;
            size = 9;
            passes = 4;
            new_optimizations = true;
            vibrancy = 0.1696;

          };
        };

        animations = {

          enabled = true;

          bezier = [
            "myBezier, 0.05, 0.9, 0.1, 1.05"
            "myBezier2, 0.65, 0, 0.35, 1"
            "slow,0,0.85,0.3,1"
            "overshot,0.7,0.6,0.1,1.1"
            "bounce,1,1.6,0.1,0.85"
            "slingshot,1,-1,0.15,1.25"
            "nice,0,6.9,0.5,-4.20"
          ];
          animation = [
            "windows,1,5,bounce,popin"
            "border,1,20,default"
            "fade,1,5,default"
            "workspaces,1,5,overshot,slide"
          ];

        };

        dwindle = {

          pseudotile = true; # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
          preserve_split = true; # You probably want this

        };

        #############
        ### INPUT ###
        #############

        input = {

          kb_layout = "us";
          kb_variant = "intl";
          kb_model = "";
          kb_options = "";
          kb_rules = "";

          mouse_refocus = false;
          sensitivity = 0; # -1.0 - 1.0, 0 means no modification.
          accel_profile = "flat";
        
        };

        cursor = {

          enable_hyprcursor = true;
          inactive_timeout = 3;
          no_break_fs_vrr = 2;
          min_refresh_rate = 48;

        };

        ##############
        ### OTHERS ###
        ##############

        misc = { 

          force_default_wallpaper = 0; # Set to 0 or 1 to disable the anime mascot wallpapers
          disable_hyprland_logo = true; # If true disables the random hyprland logo / anime girl background. :(
          animate_manual_resizes = true;
          vfr = false;

        };

        render = {

          # explicit_sync = 0;
          # explicit_sync_kms = 0;
          direct_scanout = 0;
        
        };
        # opengl.nvidia_anti_flicker = false;

        # xwayland = {
        #   force_zero_scaling = true;
        # };

        ecosystem = {
          no_update_news = true;
          no_donation_nag = true;
        };

      };
    };

    programs = {
      fuzzel = {
        enable = true;
        settings = {
          main = {
            dpi-aware = "yes";
            prompt = "‎";
            launch-prefix = "uwsm app --";
            width = 50;
            inner-pad = 15;
            fields = "filename,name";
          };
        };
      };
    };
    

    home = {

      packages = with pkgs; [

        # Multimedia
        clipse
        playerctl

        # System Apps
        nautilus
        gnome-system-monitor
        gparted
        waypaper
        grim
        slurp
        swww
        lz4 # For compressing frames when animating
        wofi
        hyprpicker
        # hyprpanel

        wlr-randr
        wl-clipboard
        wl-clip-persist
        zenity

        hyprland-workspaces

      ];
    };


    # systemd.user.services = lib.mkIf config.programs.hyprpanel.systemd.enable {
    #   hyprpanel = {
    #     Unit = {
    #       Description = "A Bar/Panel for Hyprland with extensive customizability.";
    #       Documentation = "https://hyprpanel.com";
    #       PartOf = [ "graphical-session.target" ];
    #       After = [ "graphical-session-pre.target" ];
    #     };
    #     Service = {
    #       ExecStart = "${pkgs.hyprpanel}/bin/hyprpanel";
    #       ExecReload = "${pkgs.coreutils}/bin/kill -SIGUSR1 $MAINPID";
    #       Restart = "on-failure";
    #       KillMode = "mixed";
    #     };
    #     Install = { WantedBy = [ "graphical-session.target" ]; };
    #   };
    # };

  
    # systemd.user.services = lib.mkIf config.programs.hyprpanel.systemd.enable {
    #   hyprpanel = {
    #     Unit = {
    #       Description = "A Bar/Panel for Hyprland with extensive customizability.";
    #       Documentation = "https://hyprpanel.com";
    #       PartOf = [ "graphical-session.target" ];
    #       After = [ "graphical-session-pre.target" ];
    #     };
    #     Service = {
    #       ExecStart = "${pkgs.hyprpanel}/bin/hyprpanel";
    #       ExecReload = "${pkgs.coreutils}/bin/kill -SIGUSR1 $MAINPID";
    #       Restart = "on-failure";
    #       KillMode = "mixed";
    #     };
    #     Install = { WantedBy = [ "graphical-session.target" ]; };
    #   };
    # };

    catppuccin.fuzzel.enable = false;

    # Hide GTK Window Title Buttons
    dconf.settings."org/gnome/desktop/wm/preferences".button-layout = "";

    xdg = {
      configFile = {
        "hypr/config".source = ../config/hypr/config;
        "hypr/themes".source = ../config/hypr/themes;
        "hypr/scripts".source = ../config/hypr/scripts;
      };
      mimeApps = {
        enable = true;
        defaultApplications = {
          "inode/directory" = [ "org.gnome.Nautilus.desktop" ];
        };
        associations.removed = {
          "inode/directory" = "code.desktop";
        };
      };
    };
    
  };

}
